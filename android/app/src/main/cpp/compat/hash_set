#pragma once
// Counterpart to the hash_map stand-in; three call sites spell it std::hash_set.
#include <unordered_set>
#include <functional>

namespace std {

template <
        class Key,
        class HashFcn = hash<Key>,
        class EqualKey = equal_to<Key>,
        class Alloc = allocator<Key> >
using hash_set = unordered_set<Key, HashFcn, EqualKey, Alloc>;

template <
        class Key,
        class HashFcn = hash<Key>,
        class EqualKey = equal_to<Key>,
        class Alloc = allocator<Key> >
using hash_multiset = unordered_multiset<Key, HashFcn, EqualKey, Alloc>;

}  // namespace std

